# Modal app / volume
MODAL_APP_NAME=fooocus-modal
VOLUME_NAME=fooocus-modal-data

# GPU preference order (comma-separated). L4 then A10 (24GB class).
MODAL_GPUS=L4,A10

# Seconds of idle time before the worker scales to zero (FinOps).
SCALEDOWN_WINDOW=30

# Hard cap for one generate call (seconds).
GENERATE_TIMEOUT=600

# When true: do not persist generation inputs/outputs on the Modal Volume.
ZERO_TELEMETRY=true

# Memory/GPU snapshots are DISABLED in code for now.
# Fooocus needs CUDA during container enter; CPU-only snaps fail and retry (costly).
ENABLE_MEMORY_SNAPSHOT=false
ENABLE_GPU_SNAPSHOT=false

# Fetch tiny VAE-approx/expansion sidecars on worker enter if missing on the Volume.
ENSURE_RUNTIME_ASSETS=true

# Fooocus source pin (used when building the Modal image)
FOOOCUS_REPO=https://github.com/lllyasviel/Fooocus.git
FOOOCUS_REF=main

# Local UI
LOCAL_UI_HOST=127.0.0.1
LOCAL_UI_PORT=7860
LOCAL_OUTPUT_DIR=./outputs
