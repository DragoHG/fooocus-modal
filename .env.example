# Modal app / volume
MODAL_APP_NAME=fooocus-on-modal
VOLUME_NAME=fooocus-on-modal-data

# GPU preference order (comma-separated). L4 then A10 (24GB class).
MODAL_GPUS=L4,A10

# Seconds of idle time before the worker scales to zero (FinOps).
SCALEDOWN_WINDOW=60

# When true: do not persist generation inputs/outputs on the Modal Volume.
# Results return to the local UI; ephemeral paths are used on the worker.
# When false: allow storing inputs/outputs under the Volume.
ZERO_TELEMETRY=true

# Fooocus source pin (used when building the Modal image)
FOOOCUS_REPO=https://github.com/lllyasviel/Fooocus.git
FOOOCUS_REF=main

# Local UI
LOCAL_UI_HOST=127.0.0.1
LOCAL_UI_PORT=7860
LOCAL_OUTPUT_DIR=./outputs
