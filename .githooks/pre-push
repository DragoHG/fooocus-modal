#!/usr/bin/env bash
# Block push if any outgoing commit fails sole-maintainer authorship checks.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
checker="${root}/scripts/check_git_authorship.sh"

if [[ ! -x "$checker" ]]; then
  echo "pre-push: missing executable $checker" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  if ! "$checker" "$remote_sha" "$local_sha"; then
    status=1
  fi
done

if [[ "$status" -ne 0 ]]; then
  echo "pre-push: blocked - fix authorship before pushing to the canonical remote." >&2
  exit 1
fi
exit 0
