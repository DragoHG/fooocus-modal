#!/usr/bin/env bash
# Reject commit messages with tooling co-author / provenance trailers.
set -euo pipefail

msg_file="$1"
if grep -Eiq 'co-authored-by:[[:space:]]*cursor|cursoragent@|generated by|@cursor\.com' "$msg_file"; then
  echo "commit-msg: refuse tooling co-author / provenance lines in the message." >&2
  echo "commit-msg: keep sole attribution: DragoHG <fabio.monreal@outlook.com>" >&2
  exit 1
fi
exit 0
